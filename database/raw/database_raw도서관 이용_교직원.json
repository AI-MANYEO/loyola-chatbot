            "<table>\n<caption>교직원</caption>\n<thead>\n<tr>\n<th scope=\"col\" style=\"width:15%\">구분</th>\n<th scope=\"col\" style=\"width:29%\">교수</th>\n<th scope=\"col\" style=\"width:20%\">교내발령교수/직원/강사</th>\n<th scope=\"col\" style=\"width:18%\">부설연구원</th>\n<th scope=\"col\" style=\"width:18%\">바로가기</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>출입</td>\n<td colspan=\"2\">교직원신분증, 모바일이용증</td>\n<td>자료대출증, 모바일이용증</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/31\" title=\"모바일이용증 안내\">모바일이용증 안내</a></td>\n</tr>\n<tr>\n<td>자료대출</td>\n<td>80권 120일</td>\n<td colspan=\"2\">40권 60일</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/10\" title=\"대출권수 및 기간\">대출권수 및 기간</a></td>\n</tr>\n<tr>\n<td>대출연장</td>\n<td>연장신청일로부터 60일까지 2회 연장 가능<br/>예약/연체도서 연장 불가</td>\n<td colspan=\"2\">연장신청일로부터 30일까지 2회 연장 가능<br/>예약/연체도서 연장 불가</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/196\" title=\"대출/연장/예약\">대출/연장/예약</a></td>\n</tr>\n<tr>\n<td>도서예약</td>\n<td colspan=\"3\">대출중 도서 예약 가능</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/196\" title=\"대출/연장/예약\">대출/연장/예약</a></td>\n</tr>\n<tr>\n<td>지정자료 신청</td>\n<td>학기 시작 일주일 전부터 개설 교과목 담당교수 신청</td>\n<td colspan=\"2\"><p class=\"point\">불가</p></td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/81\" title=\"지정자료신청\">지정자료신청</a></td>\n</tr>\n<tr>\n<td>전자자료 교외이용</td>\n<td colspan=\"3\">홈페이지 로그인 후 이용 가능</td>\n<td></td>\n</tr>\n<tr>\n<td>희망자료 신청</td>\n<td>매월 50권까지 신청 가능</td>\n<td colspan=\"2\">매월 10권까지 신청 가능</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/16\" title=\"희망자료신청\">희망자료신청</a></td>\n</tr>\n<tr>\n<td>타도서관 자료복사</td>\n<td colspan=\"3\">미소장 자료 신청 가능</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/18\" title=\"타도서관 자료 복사\">타도서관 자료 복사</a></td>\n</tr>\n<tr>\n<td>타도서관 자료대출</td>\n<td colspan=\"3\">기관 당 3책</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/17\" title=\"타도서관 자료 대출\">타도서관 자료 대출</a></td>\n</tr>\n<tr>\n<td>타도서관 이용</td>\n<td colspan=\"3\">도서관열람의뢰서 출력, 교직원신분증 제시 후 이용.<br/>연대/이대/홍대는 교직원신분증 제시 후 이용</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/32\" title=\"타도서관 이용 신청\">타도서관 이용 신청</a></td>\n</tr>\n<tr>\n<td>일반열람실</td>\n<td colspan=\"3\">좌석 발권 후 이용 (X관 일반열람실은 대학원생 전용임)</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/21\" title=\"일반열람실 이용 안내\">일반열람실 이용 안내</a></td>\n</tr>\n<tr>\n<td>캐럴</td>\n<td colspan=\"3\"><p class=\"point\">불가</p></td>\n<td></td>\n</tr>\n<tr>\n<td>스터디룸</td>\n<td colspan=\"3\">예약 후 이용</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/187\" title=\"스터디룸 이용 안내\">스터디룸 이용 안내</a></td>\n</tr>\n<tr>\n<td>무선랜</td>\n<td colspan=\"3\">SAINT ID, Password로 접속</td>\n<td></td>\n</tr><tr>\n<td>정보활용교육 신청</td>\n<td colspan=\"3\">홈페이지 로그인 후 신청 가능</td>\n<td><a class=\"linkStyle3\" href=\"/htmlmanager/service/3\" title=\"교육안내\">교육안내</a></td>\n</tr>\n</tbody>\n</table>"
